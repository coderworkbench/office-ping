# Copy to .env and edit values for your deployment.

# Django
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,ping.office.local,192.168.1.50

# Database
POSTGRES_DB=officeping
POSTGRES_USER=officeping
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis / Channels
REDIS_URL=redis://redis:6379/0

# CORS / CSRF (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://ping.office.local
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://ping.office.local

# Feature flags
ALLOW_MEMBERS_CREATE_GROUPS=false

# Only set this true when terminating TLS at nginx with real certs
SECURE_SSL_REDIRECT=false

# Pings each person may send (a group ping counts once): members / HR+admins
PING_RATE=5/minute
PING_RATE_ELEVATED=5/minute
# Direct pings from one person to the same person (also blocks repeat messages)
PING_RATE_PER_RECIPIENT=2/minute

# The office's time zone ("Pings today" starts at local midnight)
TIME_ZONE=Asia/Kolkata

# Urgent pings not acknowledged after this many minutes pop up again (0 = off)
URGENT_ESCALATE_AFTER_MINUTES=5

# Sign-in lockout: failures per username / per IP, and lock duration
LOGIN_MAX_FAILURES_PER_USER=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_LOCKOUT_SECONDS=900
