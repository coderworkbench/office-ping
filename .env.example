# Copy to .env and edit values for your deployment:  cp .env.example .env
# Everything here is read by the backend (python-decouple) and by
# docker-compose.yml. The defaults work for local development with `make dev`.
# Never commit .env: it holds the real secret key and database password.

# Django
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,ping.office.local,192.168.1.50

# Database (the compose stack runs Postgres with these values)
POSTGRES_DB=officeping
POSTGRES_USER=officeping
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Set true to use a local SQLite file instead of Postgres (quick experiments
# outside Docker only; the compose stack always uses Postgres)
# USE_SQLITE=false

# Redis / Channels (WebSocket fan-out, cache, rate limits, sign-in lockout)
REDIS_URL=redis://redis:6379/0

# CORS / CSRF (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://ping.office.local
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://ping.office.local

# Feature flags
ALLOW_MEMBERS_CREATE_GROUPS=false

# Only set this true when terminating TLS at nginx with real certs
SECURE_SSL_REDIRECT=false

# Pings each person may send (a group ping counts once): members / HR+admins
PING_RATE=5/minute
PING_RATE_ELEVATED=5/minute
# Direct pings from one person to the same person (also blocks repeat messages)
PING_RATE_PER_RECIPIENT=2/minute
# Chat messages each person may send
CHAT_RATE=30/minute
# Chat reactions each person may add or change
CHAT_REACT_RATE=60/minute

# The office's time zone ("Pings today" starts at local midnight)
TIME_ZONE=Asia/Kolkata

# Urgent pings not acknowledged after this many minutes pop up again (0 = off)
URGENT_ESCALATE_AFTER_MINUTES=5

# Sign-in lockout: failures per username / per IP, and lock duration
LOGIN_MAX_FAILURES_PER_USER=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_LOCKOUT_SECONDS=900

# Frontend: where the browser finds the API. Leave empty when nginx serves the
# app and the API from the same origin (the compose stack); set it only when
# running `next dev` against a backend on another address.
# NEXT_PUBLIC_API_URL=

# First admin for `python manage.py bootstrap --no-input` (scripts/fresh-install.sh).
# Pass these on the command line rather than keeping them in this file.
# ADMIN_USERNAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
